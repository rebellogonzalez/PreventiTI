APP_NAME=PreventiTI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://preventiti.local
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_URL=
DB_HOST=localhost
DB_PORT=3306
DB_SOCKET=/run/mysqld/mysqld.sock
DB_DATABASE=preventiti
DB_USERNAME=preventiti_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

MARIADB_DUMP_BINARY=/usr/bin/mariadb-dump
MARIADB_BACKUP_DEFAULTS_FILE=/etc/preventiti/backup.cnf
PREVENTITI_BACKUP_DIRECTORY=/var/backups/preventiti
